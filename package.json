{
	"dependencies": {
		"@biomejs/biome": "^2.1.3",
		"chalk": "^5.5.0",
		"ora": "^8.2.0",
		"zshy": "^0.3.4"
	},
	"description": "Sine Toolbox Monorepo",
	"name": "sine-toolbox-monorepo",
	"private": true,
	"scripts": {
		"build": "bun run --filter '*' build",
		"check:code": "bun run --filter '*' check:code",
		"check:types": "bun run --filter '*' check:types",
		"changeset:add": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"prepare": "husky",
		"commit": "bun run scripts/commit.ts"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"changelogen": "^0.6.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.4"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": [
			"biome check --write --unsafe"
		],
		"*.{json,md}": [
			"biome format --write"
		]
	}
}
