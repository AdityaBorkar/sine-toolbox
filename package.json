{
	"dependencies": {
		"@biomejs/biome": "^2.1.3",
		"@cerebras/cerebras_cloud_sdk": "^1.46.0",
		"chalk": "^5.5.0",
		"markdownlint-cli2": "^0.18.1",
		"ora": "^8.2.0",
		"prompts": "^2.4.2",
		"zshy": "^0.3.4"
	},
	"description": "Sine Toolbox Monorepo",
	"name": "sine-toolbox-monorepo",
	"private": true,
	"scripts": {
		"build": "bun run --filter '*' build",
		"check:md": "markdownlint-cli2 --config ./configs/.markdownlint-cli2.jsonc",
		"check:code": "bun run --filter '*' check:code",
		"check:types": "bun run --filter '*' check:types",
		"changeset:add": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"prepare": "husky",
		"commit": "bun run scripts/commit.ts"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"changelogen": "^0.6.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.4"
	},
	"cSpell": {}
}
